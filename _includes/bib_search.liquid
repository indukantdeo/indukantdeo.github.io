{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="publication-search">
    <label for="bibsearch" class="sr-only">Filter publications</label>
    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    <input type="search" id="bibsearch" spellcheck="false" autocomplete="off" placeholder="Search by title, author, or venue">
  </div>
{% endif %}
