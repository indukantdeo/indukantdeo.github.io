---
layout: default
---
<div class="portfolio-home">
  <header class="home-intro{% if page.profile.image %} home-intro--with-portrait{% endif %}">
    <div class="home-intro__identity">
      <h1>
        {% if site.title == 'blank' %}
          {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="home-intro__role">{{ page.subtitle }}</p>
    </div>
    {% if page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <div class="home-intro__portrait">
        {%
          include figure.liquid
          loading="eager"
          path=profile_image_path
          sizes="(max-width: 575px) 76px, (max-width: 767px) 145px, 188px"
          alt=page.profile.alt
          caption=page.profile.caption
          cache_bust=true
        %}
      </div>
    {% endif %}
    <div class="home-intro__body">
      {{ page.summary | markdownify }}
      <nav class="home-intro__links" aria-label="Portfolio shortcuts">
        <a class="home-intro__primary" href="{{ '/publications/' | relative_url }}">Publications</a>
        <a href="{{ '/cv/' | relative_url }}">CV</a>
      </nav>
    </div>
  </header>

  <article>
    {% if page.news and site.announcements.enabled %}
      <section class="home-section home-news" aria-labelledby="home-news-title">
        <div class="home-section__heading">
          <h2 id="home-news-title">Latest news</h2>
          <a href="{{ '/news/' | relative_url }}">All news</a>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-section home-papers" aria-labelledby="home-papers-title">
        <div class="home-section__heading">
          <h2 id="home-papers-title">Selected publications</h2>
          <a href="{{ '/publications/' | relative_url }}">All publications</a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <section class="home-section home-background">
      {{ content }}
    </section>

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and page.footer_fixed != false and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
